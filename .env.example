GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GEMINI_MODEL_NAME=gemini-3.5-flash-lite
USE_GROQ=true
MODEL_TEMPERATURE=0.0
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=your_neo4j_username_here
NEO4J_PASSWORD=your_neo4j_aura_password_here
SUPABASE_DB_URL=your_pooled_connection_string_here
REDIS_URL=redis://default:your_actual_password@your_actual_host:14074

# --- Stage 6: x402 stablecoin billing + Algorithmic FinOps Governance ---

# Base Sepolia testnet EOA private key used to SIGN EIP-3009 payment
# authorizations (agent side). Fund it via https://faucet.circle.com/.
# NEVER commit a real value for this.
AGENT_WALLET_PRIVATE_KEY=0xyour_testnet_wallet_private_key_here

# Destination wallet address the MCP server expects payment to. Can be a
# different address from AGENT_WALLET_PRIVATE_KEY's derived address, or
# the same wallet if you're just testing the loop end-to-end.
SERVER_WALLET_ADDRESS=0xyour_server_payout_wallet_address_here

# Destination wallet the agent client expects payment to, when it charges
# an untrusted server for MCP sampling (reciprocal 402 wall).
AGENT_SAMPLING_PAY_TO_ADDRESS=0xyour_agent_payout_wallet_address_here

# Xpay Staging Facilitator — brokers /verify and /settle.
XPAY_FACILITATOR_URL=https://facilitator.xpay.sh

# Public Base Sepolia JSON-RPC endpoint, used ONLY for read-only wallet
# balance checks in the dashboard (never for signing/sending).
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Per-call USDC price the MCP server charges for query_knowledge.
QUERY_KNOWLEDGE_PRICE_USD=0.01

# Per-call USDC price the agent client charges untrusted servers that
# request MCP sampling (reciprocal 402 wall).
SAMPLING_PRICE_USD=0.002

# Comma-separated list of MCP server names exempt from the client's
# reciprocal sampling wall (our own first-party server, by default).
TRUSTED_SAMPLING_SERVERS=ThinkingAgentServer

# Hard ceiling (USD) per full agent execution chain before the FinOps
# governor raises FinOpsBudgetExceededException and forces a safe fallback.
FINOPS_MAX_USD_PER_CHAIN=0.05