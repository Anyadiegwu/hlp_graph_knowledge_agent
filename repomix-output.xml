def generate_dashboard_chart(
    log_entries: list[dict],
    save_path: str | None = None,
) -> dict[str, Any]:
    """
    Generate a comprehensive 4-panel system health dashboard chart.
    Always saves to CHART_OUTPUT_DIR unless save_path overrides.
